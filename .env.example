# --- MySQL database (create this in Hostinger hPanel > Databases) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Auth ---
# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET=

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Outgoing email for the Contact form (optional) ---
# Use the mailbox created in Hostinger hPanel > Emails
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO_EMAIL=
